# ============================================================
# Backend Go - variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
# Nunca comite .env nem chaves reais.
# ============================================================

# Aplicação
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info
HTTP_REQUEST_LOG=true

# Banco de dados
DATABASE_URL=postgres://paroquia:paroquia@127.0.0.1:5432/paroquia?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_AUTO_MIGRATE=true

# Autenticação
# Em produção este valor é obrigatório e precisa de ao menos 32 caracteres.
AUTH_JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-bytes
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_ACCESS_COOKIE=paroquia_access
AUTH_REFRESH_COOKIE=paroquia_refresh
AUTH_RECURRING_COOKIE=recurring_mgmt
# Aceita duração Go ("24h") ou número de horas ("24").
TTL_HORAS_TOKEN_RECORRENTE=24h

# Armazenamento de arquivos
STORAGE_DIR=./data/uploads
TAMANHO_MAXIMO_ARQUIVO_MB=10

# E-mail (Resend) - opcional em desenvolvimento
CHAVE_API_RESEND=
EMAIL_REMETENTE="Paróquia <nao-responder@paroquia.local>"
EMAIL_NOTIFICACAO_ADMIN=
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF=2s
EMAIL_TIMEOUT=10s

# Stripe - opcional em desenvolvimento
CHAVE_SECRETA_STRIPE=
SEGREDO_WEBHOOK_STRIPE=
NEXT_PUBLIC_CHAVE_PUBLICA_STRIPE=
STRIPE_CURRENCY=brl
STRIPE_MIN_AMOUNT_CENTS=100
STRIPE_MAX_AMOUNT_CENTS=10000000
STRIPE_API_VERSION=2026-07-29.dahlia

# Identidade do site
SITE_NAME=Paróquia

# Limites de taxa
LIMIT_CONTACT_MAX=3
LIMIT_CONTACT_WINDOW=5m
LIMIT_RECURRING_IP_MAX=3
LIMIT_RECURRING_EMAIL_MAX=2
LIMIT_RECURRING_WINDOW=5m
