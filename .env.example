# ============================================================
# Paróquia - variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca comite .env.local nem chaves reais.
# ============================================================

# Supabase
NEXT_PUBLIC_URL_SUPABASE=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_CHAVE_PUBLICA_SUPABASE=coloque-a-chave-publica
CHAVE_SERVICO_SUPABASE=coloque-a-chave-de-servico

# Stripe
NEXT_PUBLIC_CHAVE_PUBLICA_STRIPE=pk_test_...
CHAVE_SECRETA_STRIPE=sk_test_...
SEGREDO_WEBHOOK_STRIPE=whsec_...

# Resend
CHAVE_API_RESEND=re_...
EMAIL_REMETENTE="Paróquia <nao-responder@seudominio.com>"
EMAIL_NOTIFICACAO_ADMIN=contato@seudominio.com

# Site
NEXT_PUBLIC_URL_SITE=http://localhost:3000

# Opcionais
TTL_HORAS_TOKEN_RECORRENTE=24
TAMANHO_MAXIMO_ARQUIVO_MB=10
