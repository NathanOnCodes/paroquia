# ============================================================
# Paróquia - variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca comite .env.local nem chaves reais.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=coloque-a-chave-anon-publishable
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-service-role

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM="Paróquia São Benedito e Menino Jesus <nao-responder@seudominio.com>"
ADMIN_NOTIFICATION_EMAIL=contato@seudominio.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcionais
RECURRING_TOKEN_TTL_HOURS=24
MAX_FILE_SIZE_MB=10
